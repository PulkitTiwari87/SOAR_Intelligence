# =====================================================================
# SOAR Intelligence: environment configuration
# =====================================================================
#   cp .env.example .env      then edit .env   (.env is git-ignored; never commit it)
#
# RULES: comments are on their own lines (dotenv would read an inline comment as part of the value).
# Nothing below has a working default secret. An unset key means the matching integration is
# reported as "not configured"; the platform still runs locally without any of them.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------
# development | testing | production
SOAR_ENV=development
# Session signing key, at least 32 characters. REQUIRED when SOAR_ENV=production.
# Empty in development = a random key per start (sessions reset on restart).
JWT_SECRET=
# Set true when the UI is served over HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# First administrator, created only when the database has no users (password >= 10 characters).
# Leave empty and use `python -m soar.cli create-user` instead if you prefer.
SOAR_ADMIN_USERNAME=admin
SOAR_ADMIN_PASSWORD=

# Shared secret for machine ingestion (Wazuh integration, scripts), sent as header X-API-Key.
# Empty = only logged-in users with incident:write can ingest.
INGEST_API_KEY=

# Login throttling per client IP + username, counted from the shared audit log (holds across workers and
# containers). Blocked attempts get HTTP 429 with a Retry-After header. A successful login resets the count.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ---------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------
# Local default is SQLite under ./data. docker compose uses PostgreSQL automatically.
# DATABASE_URL=sqlite:///./data/soar.db
# DATABASE_URL=postgresql://soar:PASSWORD@localhost:5432/soar
# Used by docker compose (postgres + api). REQUIRED for `docker compose up`.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# LLM INCIDENT COMMANDER (optional; decision support only, it can never execute anything)
# ---------------------------------------------------------------------
# gemini | openai | anthropic | ollama | openai_compatible | none
# `none`, or a missing key, means a deterministic and clearly labelled rule-based summary is used.
LLM_PROVIDER=gemini
# Key for the provider chosen above.
LLM_API_KEY=
# Empty = provider default (gemini-2.0-flash, gpt-4o-mini, claude-haiku-4-5-20251001, llama3.1).
LLM_MODEL=
# For ollama / openai_compatible, e.g. http://localhost:11434/v1 . Optional for the others.
LLM_BASE_URL=
# true = run the commander automatically on every new incident.
LLM_AUTO_ANALYZE=false
# Optional provider-specific keys, used when LLM_API_KEY is empty. Only the provider in use is needed.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# RESPONSE POLICY
# ---------------------------------------------------------------------
# Highest action risk that may run WITHOUT a human: none | low | medium.
# `high` (isolate_host, disable_account) always needs approval. Default `low`: block_ip waits for approval.
AUTO_EXECUTE_MAX_RISK=low
AUTO_PLAYBOOKS_ENABLED=true
# Extra comma-separated IPs/CIDRs that may never be blocked (private/loopback ranges always are).
PROTECTED_IPS=
# Optional Slack-compatible webhook for the notify_analyst action.
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------
# PIPELINE TUNING (defaults are sensible; see docs/ARCHITECTURE.md)
# ---------------------------------------------------------------------
# CORRELATION_WINDOW_MINUTES=30
# CORRELATION_THRESHOLD=3.0
# INTEL_CACHE_HOURS=24

# ---------------------------------------------------------------------
# SECURITY STACK INTEGRATIONS (all optional)
# ---------------------------------------------------------------------
# Wazuh manager API, used by block_ip / isolate_host / disable_account active response.
# e.g. https://wazuh.manager:55000
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASS=
# false ONLY for a lab manager with a self-signed certificate.
WAZUH_VERIFY_TLS=true
# Names of custom active-response commands you created on the manager. Empty = that action is skipped.
WAZUH_ISOLATE_COMMAND=
WAZUH_DISABLE_ACCOUNT_COMMAND=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASS=
# TheHive 5 (create_case). SOAR only probes Cortex status.
THEHIVE_URL=
THEHIVE_API_KEY=
CORTEX_URL=
# MISP threat intelligence (IOC enrichment).
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# ---------------------------------------------------------------------
# docker compose "siem" profile only (Wazuh + TheHive + Cortex + MISP; needs ~10 GB RAM)
# ---------------------------------------------------------------------
WAZUH_INDEXER_ADMIN_PASSWORD=
WAZUH_API_PASSWORD=
THEHIVE_SECRET=
MISP_DB_PASSWORD=
MISP_ADMIN_PASSPHRASE=
