ai/feedback/retrain_history.json
ai/feedback/phishing_feedback.json
ai/feedback/anomaly_baseline.json

# Generated reports
reports/*.pdf

# Database (runtime)
dashboard/*.db

# Environment
.env

# Docker generated
wazuh-certificates/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
.gemini/

