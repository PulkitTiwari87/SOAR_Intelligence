{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "dashboard/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/ml", "destination": "/dashboard/frontend/index.html" },
    { "source": "/(.*)", "destination": "/dashboard/frontend/$1" }
  ]
}
